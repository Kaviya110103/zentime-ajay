# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Dependencies
node_modules/

# Expo folders
.expo/
dist/
web-build/
expo-env.d.ts

# EAS Build system
.eas/
build/

# Native folders (prevent EAS build conflicts in managed workflow)
android/
ios/

# Android & iOS sensitive files
.kotlin/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro cache
.metro-health-check*

# Debug logs
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS system files
.DS_Store
*.orig.*
*.pem

# Environment variables
.env
.env.local
.env.*.local

# TypeScript build info
*.tsbuildinfo
