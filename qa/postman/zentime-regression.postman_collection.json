            "url": "{{baseUrl}}/api/clients/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('admin login returns normal auth response', function () { pm.expect([200, 400, 401, 403]).to.include(pm.response.code); });",
                  "pm.test('admin login response has no password field', function () { pm.expect(pm.response.text()).to.not.match(/\\\"password\\\"\\s*:/i); });"
                ]
              }
            }
          ]
        }
      ]
