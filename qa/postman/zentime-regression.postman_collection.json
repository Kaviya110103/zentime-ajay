{
  "info": {
    "_postman_id": "a916fa18-2c58-47ef-8c93-zentime-qa",
    "name": "ZenTime API Regression",
    "description": "QA-only regression collection for ZenTime backend APIs. Use only with a disposable QA/local backend and test data. Do not run this environment against production.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response time is below 3000 ms', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(3000);",
          "});",
          "pm.test('client response does not expose server stack trace', function () {",
          "  const text = pm.response.text() || '';",
          "  pm.expect(text).to.not.include('java.lang.');",
          "  pm.expect(text).to.not.include('org.springframework');",
          "  pm.expect(text).to.not.include('HibernateException');",
          "});",
          "pm.test('no 500 server error', function () {",
          "  pm.expect(pm.response.code).to.not.equal(500);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Regression Flow 1 - Employee Login",
      "item": [
        {
          "name": "Valid Employee Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{employeeUsername}}\",\n  \"password\": \"{{employeePassword}}\",\n  \"companyCode\": \"{{companyCode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/employees/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('valid login returns HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('valid login returns JSON employee context', function () {",
                  "  pm.response.to.be.json;",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('id');",
                  "  pm.expect(body).to.have.property('username');",
                  "  pm.expect(body).to.have.property('clientId');",
                  "});",
                  "pm.test('valid login response does not expose password', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.not.have.property('password');",
                  "  pm.expect(JSON.stringify(body)).to.not.match(/\\$2[aby]\\$/);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.id) pm.environment.set('employeeId', String(body.id));",
                  "  if (body.clientId) pm.environment.set('clientId', String(body.clientId));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Employee Login Wrong Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{employeeUsername}}\",\n  \"password\": \"wrong-password\",\n  \"companyCode\": \"{{companyCode}}\"\n}"
            },
            "url": "{{baseUrl}}/api/employees/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('wrong password is controlled client failure', function () { pm.expect([400, 401, 403, 404]).to.include(pm.response.code); });",
                  "pm.test('wrong password does not expose password data', function () { pm.expect(pm.response.text()).to.not.match(/password.*\\$2[aby]\\$/i); });"
                ]
              }
            }
          ]
        },
