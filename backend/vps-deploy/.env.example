PORT=5000
SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:mysql://YOUR_DB_HOST:3306/YOUR_MASTER_DB?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DDL_AUTO=none

APP_FLYWAY_ENABLED=true
TENANT_ROUTING_ENABLED=true
TENANT_ROUTING_PARAM_CLIENT=clientId
TENANT_ROUTING_HEADER_CLIENT=X-Client-Id
TENANT_ROUTING_HEADER_DB=X-Tenant-Db

UPLOAD_DIR=/opt/zentime/backend/uploads

PROFILE_IMAGE_S3_ENABLED=false
PROFILE_IMAGE_S3_BUCKET=
PROFILE_IMAGE_S3_REGION=ap-south-1
PROFILE_IMAGE_S3_PREFIX=employees/profile

CORS_ALLOWED_ORIGIN_PATTERNS=https://iie.zentime.co.in,https://iieadmin.zentime.co.in,https://iiesuperadmin.zentime.co.in,http://localhost:8081,http://127.0.0.1:8081

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SSL_TRUST=smtp.gmail.com
MAIL_SSL_PROTOCOLS=TLSv1.2

PUSH_ENABLED=true
PUSH_EXPO_URL=https://exp.host/--/api/v2/push/send
